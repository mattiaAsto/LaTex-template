% ============================================================================
% GLOSSARY FORMATTING
% ============================================================================
% Customize glossary appearance: spacing, margins, and font styling

\makeatletter
\renewenvironment{theglossary}%
 {%
  \begin{description}
    \setlength{\leftmargin}{\parindent}
    \setlength{\labelwidth}{-1.5em}
    \setlength{\labelsep}{1em}
    \setlength{\itemsep}{0.4\baselineskip}
    \setlength{\topsep}{0.4\baselineskip}
    \renewcommand*\glsnamefont[1]{\textbf{##1}}
 }%
 {%
  \end{description}
 }
\makeatother

% ============================================================================
% CUSTOM COMMAND DEFINITIONS & RENEWALS
% ============================================================================

% Rename standard document elements (Table of Contents, figures, tables, etc.)
\renewcommand{\contentsname}{\vSummaryName}
\renewcommand{\listfigurename}{\vListOfFiguresName}
\renewcommand{\listtablename}{\vListOfTablesName}
\renewcommand{\figurename}{\vFigureCaption}
\renewcommand{\tablename}{\vTableCaption}

% Customize list and header formatting
\renewcommand{\labelitemi}{\normalfont -}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% ============================================================================
% EXTEND SECTION HIERARCHY (add subsubsubsection support)
% ============================================================================

\titleclass{\subsubsubsection}{straight}[\subsection]
\newcounter{subsubsubsection}[subsubsection]
\renewcommand\thesubsubsubsection{\thesubsubsection.\arabic{subsubsubsection}}
\renewcommand\theparagraph{\thesubsubsubsection.\arabic{paragraph}}

% Support for custom "attachment" counter
\newcounter{attachment}
\renewcommand{\theattachment}{\arabic{attachment}}

% ============================================================================
% CUSTOM SECTION COMMANDS WITH AUTO-LABELING & HEADER
% ============================================================================

\newcounter{sectionForHeader}
\newcommand{\sectiontitle}{}
\newcommand{\newsection}[1]{
  \section{\textbar\space #1}
  \label{sec:#1}
  \setcounter{sectionForHeader}{\thesection}
  \renewcommand{\sectiontitle}{\arabic{sectionForHeader} \space \textbar \space #1}
}

% Auto-label subsections and subsubsections
\let\oldsubsection\subsection
\renewcommand{\subsection}[1]{
  \oldsubsection{#1}
  \label{sub:#1}
}

\let\oldsubsubsection\subsubsection
\renewcommand{\subsubsection}[1]{
  \oldsubsubsection{#1}
  \label{subsub:#1}
}

% ============================================================================
% FORMATTING FOR EXTENDED SECTION LEVELS
% ============================================================================

\titleformat{\subsubsubsection}
  {\normalfont\normalsize\bfseries}{\thesubsubsubsection}{1em}{}
\titlespacing*{\subsubsubsection}
{0pt}{3.25ex plus 1ex minus .2ex}{1.5ex plus .2ex}

\makeatletter
\renewcommand\paragraph{\@startsection{paragraph}{5}{\z@}%
  {3.25ex \@plus1ex \@minus.2ex}%
  {-1em}%
  {\normalfont\normalsize\bfseries}}
\renewcommand\subparagraph{\@startsection{subparagraph}{6}{\parindent}%
  {3.25ex \@plus1ex \@minus .2ex}%
  {-1em}%
  {\normalfont\normalsize\bfseries}}
\def\toclevel@subsubsubsection{4}
\def\toclevel@paragraph{5}
\def\toclevel@paragraph{6}
\def\l@subsubsubsection{\@dottedtocline{4}{7em}{4em}}
\def\l@paragraph{\@dottedtocline{5}{10em}{5em}}
\def\l@subparagraph{\@dottedtocline{6}{14em}{6em}}
\makeatother

% ============================================================================
% LIST OF ATTACHMENTS
% ============================================================================

\makeatletter
\newcommand{\listofattachments}{%
  \section*{\vListOfAttachmentsName}%
  \@starttoc{loa}%
}
\let\l@attachment\l@figure
\makeatother

% Set numbering depth for sections and TOC display
\setcounter{secnumdepth}{4}
\setcounter{tocdepth}{4}